generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Branch {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  address   String   @db.VarChar(255)
  city      String   @db.VarChar(100)
  contactNo String?  @db.VarChar(20)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
  users     User[]
  authLogs  AuthLog[]
  inventory InventoryItem[]
  expenses  Expense[]
  branchMenuItems BranchMenuItem[]
  transfersOut    InventoryTransfer[] @relation("TransferSource")
  transfersIn     InventoryTransfer[] @relation("TransferDest")
  notifications   Notification[]

  @@map("branches")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  email     String   @unique @db.VarChar(150)
  password  String   @db.VarChar(255)
  passwordResets PasswordReset[]
  role      Role     @default(CASHIER)
  branchId  Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
  branch    Branch   @relation(fields: [branchId], references: [id])
  authLogs  AuthLog[]
  inventoryAuditLogs InventoryAuditLog[] @relation("InventoryAuditActor")
  expenses  Expense[]
  transfers InventoryTransfer[]
  notifications Notification[]

  @@index([branchId])
  @@map("users")
}

model PasswordReset {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String   @db.VarChar(6)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, code])
  @@index([userId])
  @@index([code])
  @@index([expiresAt])
  @@map("password_resets")
}

model Category {
  id        Int        @id @default(autoincrement())
  name      String     @db.VarChar(100)
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())
  items     MenuItem[]

  @@map("categories")
}

model MenuItem {
  id          Int         @id @default(autoincrement())
  name        String      @db.VarChar(150)
  description String?     @db.Text
  price       Decimal     @db.Decimal(10, 2)
  imageUrl    String?     @db.VarChar(500)
  isAvailable Boolean     @default(true)
  categoryId  Int
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  photo       Bytes?      @db.MediumBlob
  category    Category    @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]
  recipes     MenuItemRecipeIngredient[]
  branchAvailability BranchMenuItem[]

  @@index([categoryId])
  @@index([isAvailable])
  @@map("menu_items")
}

model Order {
  id                 Int         @id @default(autoincrement())
  orderNumber        String      @unique @db.VarChar(30)
  status             OrderStatus @default(PENDING)
  type               OrderType   @default(DINE_IN)
  tableNumber        String?     @db.VarChar(20)
  customerName       String?     @db.VarChar(100)
  totalAmount        Decimal     @db.Decimal(10, 2)
  cogs               Decimal     @default(0.00) @db.Decimal(12, 2)
  discountTotal      Decimal     @default(0.00) @db.Decimal(10, 2)
  inventoryDeducted  Boolean     @default(false)
  vatableSales       Decimal     @default(0.00) @db.Decimal(10, 2)
  vatAmount          Decimal     @default(0.00) @db.Decimal(10, 2)
  taxRate            Decimal     @default(12.00) @db.Decimal(5, 2)
  notes              String?     @db.Text
  branchId           Int
  cashierId          Int
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  items              OrderItem[]
  branch             Branch      @relation(fields: [branchId], references: [id])
  cashier            User        @relation(fields: [cashierId], references: [id])
  payments           Payment[]
  inventoryAuditLogs InventoryAuditLog[]

  @@index([branchId])
  @@index([cashierId])
  @@index([status])
  @@index([createdAt])
  @@index([status, branchId, createdAt])
  @@map("orders")
}

model OrderItem {
  id         Int      @id @default(autoincrement())
  orderId    Int
  menuItemId Int
  quantity   Int
  unitPrice  Decimal  @db.Decimal(10, 2)
  subtotal   Decimal  @db.Decimal(10, 2)
  unitCost   Decimal  @default(0.0000) @db.Decimal(12, 4)
  cogs       Decimal  @default(0.00) @db.Decimal(12, 2)
  notes      String?  @db.VarChar(255)
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([menuItemId])
  @@map("order_items")
}

model Payment {
  id                 Int           @id @default(autoincrement())
  orderId            Int
  method             PaymentMethod
  amountPaid         Decimal       @db.Decimal(10, 2)
  change             Decimal       @default(0.00) @db.Decimal(10, 2)
  referenceNo        String?       @db.VarChar(100)
  discountType       DiscountType?
  discountLabel      String?       @db.VarChar(50)
  discountPercentage Decimal?      @db.Decimal(5, 2)
  discountAmount     Decimal?      @db.Decimal(10, 2)
  processedAt        DateTime      @default(now())
  order              Order         @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("payments")
}

model AuthLog {
  id        Int            @id @default(autoincrement())
  userId    Int
  branchId  Int
  role      Role
  action    AuthLogAction
  ipAddress String?        @db.VarChar(45)
  userAgent String?        @db.VarChar(255)
  createdAt DateTime       @default(now())
  branch    Branch         @relation(fields: [branchId], references: [id])
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([branchId])
  @@index([createdAt])
  @@index([action])
  @@map("auth_logs")
}

model Ingredient {
  id                         Int                        @id @default(autoincrement())
  name                       String                     @unique @db.VarChar(150)
  category                   IngredientCategory
  unit                       InventoryUnit
  yieldPercentage            Decimal                    @default(100.00) @db.Decimal(5, 2)
  defaultConsumptionRateDays Int?
  defaultConsumptionLabel    String?                    @db.VarChar(100)
  defaultDailyDeduction      Decimal?                   @db.Decimal(12, 3)
  defaultPrice               Decimal?                   @db.Decimal(12, 4)
  defaultMinThreshold        Decimal?                   @db.Decimal(12, 3)
  gramsPerUnit               Decimal?                   @db.Decimal(12, 3)
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt
  inventory                  InventoryItem[]
  recipes                    MenuItemRecipeIngredient[]
  transfers                  InventoryTransfer[]

  @@map("ingredients")
}

model InventoryItem {
  id                  Int                 @id @default(autoincrement())
  ingredientId        Int
  branchId            Int
  quantity            Decimal             @db.Decimal(12, 3)
  minThreshold        Decimal             @default(0.000) @db.Decimal(12, 3)
  price               Decimal?            @db.Decimal(12, 4)
  consumptionRateDays Int?
  consumptionLabel    String?             @db.VarChar(100)
  dailyDeductionAmount Decimal?           @db.Decimal(12, 3)
  isActive            Boolean             @default(true)
  alertState          InventoryAlertState @default(NORMAL)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  ingredient          Ingredient          @relation(fields: [ingredientId], references: [id])
  branch              Branch              @relation(fields: [branchId], references: [id])
  auditLogs           InventoryAuditLog[]
  notifications       Notification[]

  @@unique([branchId, ingredientId])
  @@index([branchId])
  @@index([ingredientId])
  @@index([isActive])
  @@map("inventory_items")
}

model MenuItemRecipeIngredient {
  id           Int            @id @default(autoincrement())
  menuItemId   Int
  ingredientId Int
  quantity     Decimal        @db.Decimal(12, 3)
  unit         InventoryUnit?
  yieldFactor  Decimal        @default(1.00) @db.Decimal(5, 2)
  createdAt    DateTime       @default(now())
  menuItem     MenuItem       @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredient   Ingredient     @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, ingredientId])
  @@index([ingredientId])
  @@map("menu_item_recipes")
}

model InventoryAuditLog {
  id              Int                 @id @default(autoincrement())
  inventoryItemId Int
  actionType      InventoryActionType
  quantityBefore  Decimal             @db.Decimal(12, 3)
  quantityAfter   Decimal             @db.Decimal(12, 3)
  quantityChanged Decimal             @db.Decimal(12, 3)
  unitCost        Decimal?            @db.Decimal(12, 4)
  totalCost       Decimal?            @db.Decimal(12, 2)
  referenceNo     String?             @db.VarChar(100)
  note            String?             @db.VarChar(255)
  orderId         Int?
  actorUserId     Int?
  createdAt       DateTime            @default(now())
  inventoryItem   InventoryItem       @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  order           Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  actor           User?               @relation("InventoryAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([inventoryItemId])
  @@index([actionType])
  @@index([createdAt])
  @@index([orderId])
  @@map("inventory_audit_logs")
}

model Expense {
  id          Int             @id @default(autoincrement())
  branchId    Int
  category    ExpenseCategory @default(OTHER)
  amount      Decimal         @db.Decimal(10, 2)
  description String?         @db.VarChar(255)
  expenseDate DateTime        @default(now())
  actorUserId Int?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  branch      Branch          @relation(fields: [branchId], references: [id])
  actor       User?           @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([branchId])
  @@index([category])
  @@index([expenseDate])
  @@map("expenses")
}

enum Role {
  OWNER
  MANAGER
  CASHIER
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum OrderType {
  DINE_IN
  TAKEOUT
  DELIVERY
}

enum PaymentMethod {
  CASH
  GCASH
  MAYA
  CARD
}

enum AuthLogAction {
  LOGIN
  LOGOUT
}

enum IngredientCategory {
  SAUCE
  SPICES
  MAIN_INGREDIENT
  RICE
  UTILITIES
  GAS
}

enum InventoryUnit {
  KG
  GRAM
  LITER
  ML
  PCS
  GALLON
  TANK
  BAG
  PACK
  TUB
}

enum InventoryActionType {
  ORDER_DEDUCTION
  ORDER_RESTORE
  DAILY_DEDUCTION
  MANUAL_EDIT
  RESTOCK
  WASTAGE
  TRANSFER_OUT
  TRANSFER_IN
}

enum DiscountType {
  SENIOR
  PWD
  STUDENT
}

enum ExpenseCategory {
  RENT
  UTILITIES
  SALARIES
  SUPPLIES
  MAINTENANCE
  OTHER
}

model BranchMenuItem {
  id          Int      @id @default(autoincrement())
  branchId    Int
  menuItemId  Int
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  menuItem    MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([branchId, menuItemId])
  @@index([branchId])
  @@index([menuItemId])
  @@map("branch_menu_items")
}

model InventoryTransfer {
  id              Int            @id @default(autoincrement())
  transferNo      String         @unique @db.VarChar(50)
  sourceBranchId  Int
  destBranchId    Int
  ingredientId    Int
  quantity        Decimal        @db.Decimal(12, 3)
  unit            InventoryUnit
  inputQuantity   Decimal?       @db.Decimal(12, 3)
  inputUnit       String?        @db.VarChar(50)
  conversionFactor Decimal?      @db.Decimal(12, 3)
  status          TransferStatus @default(COMPLETED)
  unitCost        Decimal?       @db.Decimal(12, 4)
  totalCost       Decimal?       @db.Decimal(12, 2)
  notes           String?        @db.VarChar(255)
  actorUserId     Int
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  sourceBranch    Branch         @relation("TransferSource", fields: [sourceBranchId], references: [id])
  destBranch      Branch         @relation("TransferDest", fields: [destBranchId], references: [id])
  ingredient      Ingredient     @relation(fields: [ingredientId], references: [id])
  actor           User           @relation(fields: [actorUserId], references: [id])

  @@index([sourceBranchId])
  @@index([destBranchId])
  @@index([ingredientId])
  @@map("inventory_transfers")
}

enum TransferStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum InventoryAlertState {
  NORMAL
  LOW_STOCK
  OUT_OF_STOCK
}

enum NotificationType {
  OUT_OF_STOCK
  LOW_STOCK
  RESTOCKED
  ORDER_CREATED
  ORDER_CANCELLED
  SYSTEM
}

enum NotificationSeverity {
  CRITICAL
  WARNING
  INFO
  RECOVERY
}

model Notification {
  id              Int                  @id @default(autoincrement())
  userId          Int
  branchId        Int?
  inventoryItemId Int?
  orderId         Int?
  type            NotificationType
  severity        NotificationSeverity
  outboxEventId   String?              @db.VarChar(64)
  title           String               @db.VarChar(150)
  message         String               @db.VarChar(500)
  itemName        String?              @db.VarChar(150)
  branchName      String?              @db.VarChar(100)
  currentQty      Decimal?             @db.Decimal(12, 3)
  minThreshold    Decimal?             @db.Decimal(12, 3)
  unit            InventoryUnit?
  actionUrl       String?              @db.VarChar(255)
  isRead          Boolean              @default(false)
  readAt          DateTime?
  isResolved      Boolean              @default(false)
  resolvedAt      DateTime?
  createdAt       DateTime             @default(now())

  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch          Branch?              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem?       @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)

  @@unique([outboxEventId, userId])
  @@index([userId, isRead, createdAt])
  @@index([userId, createdAt])
  @@index([branchId, type, isResolved])
  @@index([inventoryItemId, type, isResolved])
  @@map("notifications")
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

model NotificationOutbox {
  id              Int                 @id @default(autoincrement())
  eventId         String              @unique @db.VarChar(64)
  idempotencyKey  String              @unique @db.VarChar(128)
  inventoryItemId Int
  branchId        Int
  targetState     InventoryAlertState
  eventType       NotificationType
  newQuantity     Decimal             @db.Decimal(12, 3)
  minThreshold    Decimal             @db.Decimal(12, 3)
  itemName        String?             @db.VarChar(150)
  branchName      String?             @db.VarChar(100)
  unit            InventoryUnit?
  status          OutboxStatus        @default(PENDING)
  attempts        Int                 @default(0)
  nextRetryAt     DateTime            @default(now())
  lastError       String?             @db.VarChar(500)
  processedAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([status, nextRetryAt, createdAt])
  @@index([inventoryItemId, status])
  @@index([branchId])
  @@map("notification_outbox")
}
