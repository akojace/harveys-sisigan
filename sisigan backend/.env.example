# =============================================================================
# HARVEY'S SISIGAN POS BACKEND — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env for local development:
#   cp .env.example .env
#
# NEVER commit real credentials or .env files to GitHub.
# =============================================================================

# Server Port and Environment
PORT=3000
NODE_ENV=development

# JWT Authentication Secret (Use a strong random 32+ character key in production)
JWT_SECRET=your_super_secret_jwt_key_here_at_least_32_characters

# CORS Allowed Origin (e.g., https://your-production-domain.com or *)
CORS_ORIGIN=*

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# Option 1: Standard Prisma Connection URL (Recommended)
# Format: mysql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?connection_limit=10&connect_timeout=15&pool_timeout=20
#
# Local Development (e.g. XAMPP MySQL):
DATABASE_URL="mysql://root:@localhost:3306/sisigan_pos"
#
# Render / Production (Hostinger Remote MySQL example):
# DATABASE_URL="mysql://u123456789_sisigan:StrongPassword123!@153.92.15.53:3306/u123456789_sisigan_pos?connection_limit=10&connect_timeout=15&pool_timeout=20"

# Option 2: Discrete DB Environment Variables (Alternative)
# If DATABASE_URL is not set, the backend will automatically construct it from these:
# DB_HOST=153.92.15.53
# DB_PORT=3306
# DB_USER=u123456789_sisigan
# DB_PASSWORD=your_database_password
# DB_NAME=u123456789_sisigan_pos
# DB_SSL=false

